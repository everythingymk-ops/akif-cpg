# Supabase — see supabase/README.md for where these come from.
# Copy this file to .env.local and fill it in. .env* is gitignored.
#
# The publishable key is public by design: it ships in the browser bundle and
# only identifies the project. Row-level security is what protects the data.
# NEVER put a secret/service_role key here — it bypasses every policy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_WORKSPACE_ID=
