# Supabase — see supabase/README.md for where these come from.
# Copy this file to .env.local and fill it in. .env* is gitignored.
#
# The anon key is public by design: it ships in the browser bundle and only
# identifies the project. Row-level security is what protects the data.
# NEVER put the service_role key here — it bypasses every policy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_WORKSPACE_ID=
